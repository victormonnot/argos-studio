# Copy to .env in the directory from which you launch Studio.
# Existing process environment variables take precedence. Restart after editing.
# Keep credentials in .env only; this example is public.

ARGOS_STUDIO_AGENT_PROVIDER=openai
ARGOS_STUDIO_AGENT_MODEL=
OPENAI_API_KEY=

# Optional storage and native ARGOS reader configuration:
# ARGOS_STUDIO_DATA_DIR=.data
# ARGOS_STUDIO_ARGOS_ROOT=/absolute/path/to/argos
# ARGOS_STUDIO_ARGOS_PYTHON=/absolute/path/to/argos/.venv/bin/python
